# Keep the repository to source and setup files: code, README, requirements
# and run scripts. The dataset, generated results, local environments and
# exported archives are not committed.

# Local Python environments
trait-env/
.venv/
.venv-*/
venv/
env/
.env/
.pyenv/
conda-env/

# Environment/secrets files
.env
.env.*
!.env.example

# Python caches and test/build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.so
*.whl

# Raw data and generated pipeline data
data/*
!data/.gitkeep
!data/README.md
!data/README*

# Pipeline outputs and run artifacts
results/
**/results/
logs/
**/logs/
ckpts/
feat_ckpts/
feature_ckpts/
track_features.csv
splits_folds.csv
split_statistics.csv
pipeline.cfg
pipeline_*.log

# Exported archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Generated model/binary artifacts
*.pkl
*.joblib
*.ubj
*.pt
*.pth
*.ckpt
*.onnx

# Local caches
.tmp/
.cache/

# Editor and OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local deployment files (not part of this repository)
deployment/

# Manuscript sources (not distributed with the code)
manuscript/
# Keep the repository to source + setup files only.
# Commit code, README/docs, requirements, and run scripts.
# Do not commit raw datasets, generated results, local environments,
# assistant state, or review/export bundles.

# Local Python environments
trait-env/
.venv/
.venv-*/
venv/
env/
.env/
.pyenv/
conda-env/

# Environment/secrets files
.env
.env.*
!.env.example

# Python caches and test/build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.so
*.whl

# Raw data and generated pipeline data
data/*
!data/.gitkeep
!data/README.md
!data/README*

# Pipeline outputs and run artifacts
results/
**/results/
logs/
**/logs/
catboost_info/
ckpts/
feat_ckpts/
feature_ckpts/
track_features.csv
splits_folds.csv
split_statistics.csv
pipeline.cfg
pipeline_*.log

# Review/result bundles and exported archives
M*_R*/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Generated model/binary artifacts
*.pkl
*.joblib
*.ubj
*.pt
*.pth
*.ckpt
*.onnx

# Local assistant/tooling state
.claude/
.codex/
.tmp/
.cache/

# Editor and OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
